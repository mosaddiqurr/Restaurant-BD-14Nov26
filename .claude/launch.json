{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "website/serve.py",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "mobile",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "website/serve.py",
        "8766"
      ],
      "port": 8766
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "start",
        "--",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
}